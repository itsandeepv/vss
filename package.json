{
  "name": "vanshika-security-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "images": "node scripts/optimize-images.mjs",
    "video": "node scripts/make-hero-video.mjs",
    "start:local": "node --env-file=.env .next/standalone/server.js",
    "mail:verify": "node --env-file=.env scripts/mail-verify.mjs",
    "mail:sink": "node scripts/smtp-sink.mjs",
    "brochure": "tsx --tsconfig tsconfig.json --env-file=.env scripts/brochure/make-brochure.tsx"
  },
  "dependencies": {
    "next": "16.3.8",
    "nodemailer": "^10.0.14",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "ffmpeg-static": "^5.3.0",
    "mailparser": "^3.9.35",
    "puppeteer-core": "^25.12.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "smtp-server": "^3.19.17",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
