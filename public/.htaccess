# =====================================================================
# Vanshika Security Service — Apache / cPanel config for the static export
# (copied into /out by `npm run build`; upload the CONTENTS of /out to public_html)
# =====================================================================

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# ---------- Force HTTPS (enable after SSL is active — see README) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Optional: force www (or swap to force non-www). TODO: confirm preferred domain form.
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Block dotfiles (except .well-known for SSL validation) and build/source leftovers.
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^(_source|refernce-content|node_modules|src|scripts)(/|$) - [F,L]
  RewriteRule \.(md|ts|tsx|mjs|json|lock|log|env)$ - [F,L]
</IfModule>

# Allow the web app manifest even though *.json-like files are blocked above.
<Files "manifest.webmanifest">
  Require all granted
</Files>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml image/x-icon font/ttf
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
</IfModule>

# ---------- Caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Next.js puts content-hashed files under /_next/static — safe to cache forever.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Enable HSTS only once HTTPS works on every subdomain you use:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
