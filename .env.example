# Copy to .env.local (local dev) or .env.production.local (production build) and fill in.
# All values are baked into the static HTML/JS at build time — rebuild after changing them.

# Public site URL, no trailing slash. Used for canonical URL, Open Graph, sitemap and schema.
# TODO: confirm domain
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Web3Forms access key (free) — create at https://web3forms.com with the inbox that should
# receive enquiries (e.g. vssagency05@gmail.com). This key is safe to expose publicly;
# it only identifies the destination inbox. No SMTP password is ever needed.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Local testing only: send the form to the mock endpoint instead of Web3Forms
# (run `npm run mock:form` in another terminal). Leave empty in production.
NEXT_PUBLIC_FORM_ENDPOINT=
