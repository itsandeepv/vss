# Copy to .env and fill in. On cPanel/Vercel, enter the same variables in the hosting panel instead.
# NEXT_PUBLIC_* values are baked in at build time (rebuild after changing); MAIL_* are read at runtime.

# Public site URL, no trailing slash. Used for canonical URL, Open Graph, sitemap and schema.
NEXT_PUBLIC_SITE_URL=https://vanshikasecurity.com





# ---- SMTP (server-side only — never NEXT_PUBLIC_) — used by /api/enquiry to email enquiries ----
# Gmail / Google Workspace: smtp.gmail.com, 587, tls, and a 16-char App Password (not the login password).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
# Where enquiries are delivered (default: vssagency05@gmail.com)
MAIL_TO_ADDRESS=vssagency05@gmail.com
# Sender display name (default "VSS Website")
ENQUIRY_FROM_NAME=VSS Website
# Thank-you email to customers who leave an email (default: on only if MAIL_FROM_ADDRESS is the VSS email)
MAIL_AUTO_REPLY=
# Optional: fixed secret for the anti-spam time token (any long random string)
ENQUIRY_SECRET=
